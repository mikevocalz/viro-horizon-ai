# Online chat fallback (Google Gemini via the Vercel AI SDK).
# Read server-side by @ai-sdk/google in src/app/api/chat+api.ts.
GOOGLE_GENERATIVE_AI_API_KEY=

# Production only: absolute origin that hosts the Expo Router API routes
# (e.g. your EAS Hosting deployment). Leave unset in development — the app
# derives the URL from the Expo dev server.
# EXPO_PUBLIC_API_BASE_URL=https://your-api-host.example.com
